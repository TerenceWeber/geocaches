          <groundspeak:date>2026-06-23T00:00:00Z</groundspeak:date>
          <groundspeak:type>Found it</groundspeak:type>
          <groundspeak:finder id="">arloroster</groundspeak:finder>
          <groundspeak:text encoded="False">TFTC! Pls replace log or waterproof better</groundspeak:text>
