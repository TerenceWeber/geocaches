        <groundspeak:attribute id="65" inc="1">Private residence</groundspeak:attribute>
        <groundspeak:attribute id="32" inc="1">Bicycles allowed</groundspeak:attribute>
        <groundspeak:attribute id="62" inc="1">Seasonal access</groundspeak:attribute>
