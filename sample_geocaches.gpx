          <groundspeak:finder id="">PDXBandits</groundspeak:finder>
          <groundspeak:text encoded="False">Great find on a cloudy summer day!</groundspeak:text>
        </groundspeak:log>
        <groundspeak:log id="1368934152">
          <groundspeak:date>2026-06-26T00:00:00Z</groundspeak:date>
          <groundspeak:type>Found it</groundspeak:type>
          <groundspeak:finder id="">Cool Cow Cachers</groundspeak:finder>
          <groundspeak:text encoded="False">&lt;p&gt;June 26, 2026&lt;br /&gt; 8:02 PM&lt;/p&gt; &lt;p&gt;We came to Portland this weekend specifically targeting caches for the Portland Neighborhood Challenge. We stopped here just before checking into our hotel for the night. &lt;/p&gt; &lt;p&gt;Thank you, Theadorkable, LindaRM, for cowntributing to our fun today!&lt;/p&gt; &lt;p&gt;Cool Cow Cachers, off to find an-udder one... ?&lt;/p&gt;</groundspeak:text>
        </groundspeak:log>
